{
    "$schema": "https://streams.dev/schema/streams.schema.json",
    "id": "todos",
    "name": "Todos",
    "description": "Todos stream (generated by streams:onboard).",
    "config": {
        "abstract": "App\\Domains\\Todos\\Models\\Todo",
        "repository": "App\\Domains\\Todos\\Repositories\\Todos",
        "source": {
            "type": "filebase",
            "format": "json"
        }
    },
    "fields": [
        {
            "handle": "id",
            "type": "uuid",
            "required": true,
            "unique": true,
            "config": {
                "default": true
            }
        },
        {
            "handle": "title",
            "type": "string",
            "required": true
        },
        {
            "handle": "completed",
            "type": "boolean",
            "config": {
                "default": false
            }
        }
    ],
    "ui": {
        "pages": {
            "manage": {
                "handle": "manage",
                "title": "Manage Todos",
                "section": "todos",
                "table": "table"
            }
        },
        "table": {
            "handle": "table",
            "name": "Todos"
        },
        "actions": {
            "add": {
                "handle": "add",
                "label": "Add Todo",
                "type": "modal",
                "form": {
                    "handle": "form",
                    "name": "Add Todo",
                    "sections": {
                        "basics": {
                            "handle": "basics",
                            "name": "Basics",
                            "fields": [
                                {
                                    "handle": "title",
                                    "type": "string",
                                    "required": true
                                }
                            ]
                        }
                    },
                    "buttons": [
                        {
                            "handle": "save",
                            "label": "Save"
                        },
                        {
                            "handle": "cancel",
                            "label": "Cancel"
                        }
                    ]
                }
            }
        }
    }
}
